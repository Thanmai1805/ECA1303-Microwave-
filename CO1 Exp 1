
clc; clear; close all;
c=3e8; f=10e9; a=22.86e-3; b=10.16e-3;
fc1=c/(2*a); fc2=c/2*sqrt((1/a)^2+(1/b)^2); k=2*pi*f/c;
beta1=sqrt(k^2-(2*pi*fc1/c)^2);
x=linspace(0,a,50); y=linspace(0,b,50); [X,Y]=meshgrid(x,y);
E1=sin(pi*X/a); H1=cos(pi*X/a); E2=sin(pi*X/a).*sin(pi*Y/b); H2=cos(pi*X/a).*cos(pi*Y/b);
figure('Color','w');
subplot(2,3,1); contourf(X*1e3,Y*1e3,E1,20,'LineColor','none'); colorbar; title('TE10 E-field'); xlabel('x mm'); ylabel('y mm');
subplot(2,3,2); contourf(X*1e3,Y*1e3,H1,20,'LineColor','none'); colorbar; title('TE10 H-field'); xlabel('x mm'); ylabel('y mm');
subplot(2,3,3); contourf(X*1e3,Y*1e3,E2,20,'LineColor','none'); colorbar; title('TM11 E-field'); xlabel('x mm'); ylabel('y mm');
subplot(2,3,4); contourf(X*1e3,Y*1e3,H2,20,'LineColor','none'); colorbar; title('TM11 H-field'); xlabel('x mm'); ylabel('y mm');
subplot(2,3,5); plot([1 2],[fc1 fc2]/1e9,'o-','LineWidth',2); set(gca,'XTick',[1 2],'XTickLabel',{'TE10','TM11'}); ylabel('GHz'); title('Cutoff Frequency'); grid on;
subplot(2,3,6); plot(1,beta1,'bo','LineWidth',2); hold on; set(gca,'XTick',[1 2],'XTickLabel',{'TE10','TM11'}); ylabel('rad/m'); title('Propagation Constant'); grid on;
fprintf('TE10: fc=%.3f GHz, beta=%.2f rad/m\n',fc1/1e9,beta1);
fprintf('TM11: fc=%.3f GHz; below cutoff at 10 GHz.\n',fc2/1e9);
fprintf('TE10 propagates; TM11 does not.\n');
